#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Layers

#define NUM_L 1
#define SYM_L 2

&lt { quick-tap-ms = <150>; };

&mt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        // Left-hand home row mods — trigger only on right-hand keypress
        // Right-hand home row mods — trigger only on left-hand keypress
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W            &kp E        &kp R         &kp T        &kp Y        &kp U              &kp I        &kp O            &kp P
&mt LGUI A  &mt RIGHT_ALT S  &mt LCTRL D  &mt LSHIFT F  &kp G        &kp H        &mt RIGHT_SHIFT J  &mt RCTRL K  &mt RIGHT_ALT L  &kp SEMICOLON
&kp Z       &kp X            &kp C        &kp V         &kp B        &kp N        &kp M              &kp COMMA    &kp DOT          &kp FSLH
                                          &mo 1         &kp SPACE    &lt 2 ENTER  &kp BACKSPACE
            >;
        };

        num_layer {
            bindings = <
&kp ESCAPE      &kp N7  &kp N8  &kp N9  &kp BACKSLASH    &none             &none              &none   &none      &none
&kp TAB         &kp N4  &kp N5  &kp N6  &kp MINUS        &kp LEFT          &kp DOWN           &kp UP  &kp RIGHT  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp N1  &kp N2  &kp N3  &kp EQUAL        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &trans     &trans
                                &none   &kp N0           &trans            &kp DEL
            >;
        };

        f_layer {
            bindings = <
&none           &kp UP_ARROW    &none      &none  &none    &kp F1  &kp F2          &kp F3   &kp F4   &bt BT_CLR
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none  &none    &kp F5  &kp F6          &kp F7   &kp F8   &bt BT_NXT
&none           &none           &none      &none  &none    &kp F9  &kp F10         &kp F11  &kp F12  &bt BT_PRV
                                           &none  &none    &trans  &bt BT_CLR_ALL
            >;
        };

        sys_layer {
            bindings = <
&sys_reset      &trans  &trans  &trans      &bt BT_SEL 0    &out OUT_TOG  &trans  &trans  &trans  &sys_reset
&bootloader     &trans  &trans  &trans      &bt BT_SEL 1    &out OUT_BLE  &trans  &trans  &trans  &bootloader
&bt BT_CLR_ALL  &trans  &trans  &bt BT_CLR  &bt BT_SEL 2    &out OUT_USB  &trans  &trans  &trans  &trans
                                &trans      &trans          &trans        &trans
            >;
        };

        function_layer {
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9  &kp RBKT          &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp COLON
&kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK    &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &kp SQT
&kp F10  &kp F1  &kp F2  &kp F3  &kp N0            &trans    &trans     &trans     &trans     &trans
                         &trans  &kp ESC           &trans    &trans
            >;
        };
    };
};
